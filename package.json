{
  "name": "rizal-journey",
  "version": "0.1.0",
  "description": "Through Rizal's Eyes: an explorable 3D story of Jose Rizal in France, 1882-1891",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite build --config preview/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "gsap": "^3.15.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/bodoni-moda": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "private": true,
  "type": "module"
}
